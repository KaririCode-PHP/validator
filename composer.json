{
    "name": "kariricode/validator",
    "description": "Composable, rule-based data validation engine for PHP 8.4+ — #[Validate] attributes, collect-all semantics, i18n messages, zero dependencies. ARFA 1.3.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "validator",
        "validation",
        "php84",
        "kariricode",
        "arfa"
    ],
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "community@kariricode.org"
        }
    ],
    "homepage": "https://kariricode.org",
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\Validator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\Validator\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "support": {
        "issues": "https://github.com/KaririCode-Framework/kariricode-validator/issues",
        "source": "https://github.com/KaririCode-Framework/kariricode-validator"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
